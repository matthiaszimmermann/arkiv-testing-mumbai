# Copy to .env, which git ignores, and fill in. bun reads .env on its own.
# Never paste keys into chat or commit them.

# The chain: rabdi, Arkiv's testnet. The run stops if the RPC serves another chain id.
ARKIV_RPC_URL=https://rpc.rabdi.db-chain.testnet.arkiv.network
ARKIV_CHAIN_ID=7794095

# Optional, but without it the endpoint is heavily rate limited. Get a free one at
# https://hub.arkiv.network/access-keys. The run appends it to ARKIV_RPC_URL.
ARKIV_RPC_ACCESS_KEY=

# The sender's encrypted keystore, made with `bun run new-wallet`. The run asks for its password
# on the terminal; no private key is ever written in plaintext. wallets/ is ignored by git.
ARKIV_KEYSTORE=wallets/sender.json

# The longest lifetime: the chain's genesis file, or max_lifetime in blocks directly.
# If both are set they must agree.
GENESIS=
MAX_LIFETIME=7884000

# GLM price in USD for the dollar figures.
GLM_USD=0.1

# What to run. Defaults: creates,ops with 3 entities per combination.
# SECTIONS=creates,ops
# COUNT=3
# ONLY=minimal/short

# Block fill: only with SECTIONS=block on its own, and only with keystores of funded accounts
# given for it, comma-separated, one sender each. Make them with
# `bun run new-wallet wallets/block-01.json` and so on; one password for all is asked for once.
# BLOCK_KEYSTORES=wallets/block-01.json,wallets/block-02.json
# BLOCK_CREATES=5
# BLOCK_PATCHES=5
# BLOCK_EXTENDS=5
